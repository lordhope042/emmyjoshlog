{
  "name": "emmyjosh-logs-api",
  "version": "0.2.0",
  "private": true,
  "description": "Customer Express/Prisma API mounted by the Emmyjosh marketplace",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:setup": "node -r dotenv/config ../backend/setup.js",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.0.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.4.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": { "prisma": "6.0.0" }
}
