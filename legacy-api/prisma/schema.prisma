// Customer ORM schema. Root backend/migrations owns all database DDL.
// Do not run db push/reset against a populated database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CUSTOMER API
// ============================================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum VirtualAccountStatus {
  ACTIVE
  DISABLED
}

enum WalletTxType {
  WALLET_CREDIT
  PURCHASE_DEBIT
  REFUND
  ADJUSTMENT
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

model User {
  id              String      @id @default(cuid())
  fullName        String
  username        String      @unique
  email           String      @unique
  phoneNumber     String      @unique
  passwordHash    String
  role            Role        @default(CUSTOMER)
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  wallet          Wallet?
  virtualAccount  VirtualAccount?
  orders          Order[]
  notifications   Notification[]
  walletTransactions WalletTransaction[]
  supportTickets  SupportTicket[]
  auditLogs       AdminAuditLog[] @relation("Actor")
  tokenVersion  Int         @default(0)
}

model ProductCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  products    Product[]
}

model Product {
  id          String       @id @default(cuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  name        String
  slug        String       @unique
  description String?
  price       Decimal      @db.Decimal(14, 2)
  currency    String       @default("NGN")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  inventory   ProductInventory[]
  orderItems  OrderItem[]

  @@index([categoryId, status])
  @@index([status, createdAt])
}

model ProductInventory {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  stockReference String
  status        InventoryStatus @default(AVAILABLE)
  reservedAt    DateTime?
  soldAt        DateTime?
  createdAt     DateTime        @default(now())

  @@index([productId, status])
}

model VirtualAccount {
  id                         String               @id @default(cuid())
  userId                     String               @unique // one active account per customer
  user                       User                 @relation(fields: [userId], references: [id])
  provider                   String               @default("pocketfi")
  providerCustomerReference  String?
  providerAccountReference   String?              @unique
  accountNumber              String
  bankName                   String
  accountName                String
  phoneNumber                String
  currency                   String               @default("NGN")
  status                     VirtualAccountStatus @default(ACTIVE)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@unique([provider, accountNumber, currency])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("NGN")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String         @id @default(cuid())
  walletId          String
  wallet            Wallet         @relation(fields: [walletId], references: [id])
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  type              WalletTxType
  amount            Decimal        @db.Decimal(14, 2)
  currency          String         @default("NGN")
  reference         String         @unique
  providerReference String?        @unique // idempotency key from PocketFi
  status            WalletTxStatus @default(COMPLETED)
  description       String?
  createdAt         DateTime       @default(now())

  @@index([userId, createdAt])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  orderReference String     @unique
  subtotal      Decimal     @db.Decimal(14, 2)
  fees          Decimal     @default(0) @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)
  currency      String      @default("NGN")
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  unitPrice          Decimal @db.Decimal(14, 2)
  quantity           Int     @default(1)
  lineTotal          Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String?
  provider          String   @default("pocketfi")
  providerReference String   @unique
  amount            Decimal  @db.Decimal(14, 2)
  currency          String
  status            String // provider's final status, e.g. SUCCESS/FAILED
  rawEvent          Json?
  createdAt         DateTime @default(now())
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("pocketfi")
  eventId     String    @unique // idempotency: one row per provider event
  type        String?
  status      String    @default("RECEIVED") // RECEIVED/PROCESSED/IGNORED/FAILED
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String    // WALLET_DEPOSIT / ORDER_COMPLETED / ORDER_STATUS / SECURITY / SUPPORT
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN") // OPEN/ANSWERED/CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole String // CUSTOMER/ADMIN
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("Actor", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}
