{
  "name": "emmyjosh-marketplace",
  "version": "3.0.0",
  "private": true,
  "description": "Emmyjosh Marketplace with encrypted authorized stock, safe wallet checkout and configurable providers",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "legacy-api"
  ],
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node build.js",
    "db:setup": "node -r dotenv/config backend/setup.js",
    "db:generate": "npm --prefix legacy-api run db:generate",
    "test": "node --test tests/*.test.js",
    "export:source": "python3 tools/export_source.py"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mysql2": "^3.24.6",
    "simple-icons": "15.14.0"
  }
}
